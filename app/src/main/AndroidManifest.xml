<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão necessária para alterar modo Silencioso / DND via NotificationManager & AudioManager -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Notificações inteligentes de timer e prompt ao silenciar pelos botões físicos (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Agendamento pontual de períodos de som (compatível com a política da Google Play) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Permissões sob demanda (Just-in-Time) para automação opcional por Local / Geofence -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Necessário para o Mapa Interativo OpenStreetMap e busca gratuita de endereços em Locais -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:name=".ManageSoundApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.ManageSoundMode">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Permite abrir o app com toque longo no Quick Settings Tile -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- [AUTO-04] Activity de configuração para Modos do Sistema (AutomaticZenRule) no Android 15+ -->
            <intent-filter>
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Receiver para Alarmes de Horário, Boot do Sistema, Notificações, Modos do Sistema e Geofencing -->
        <receiver
            android:name=".receiver.SystemAutomationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <action android:name="android.app.action.AUTOMATIC_ZEN_RULE_STATUS_CHANGED" />
                <action android:name="com.managesoundmode.app.action.EVALUATE_RULES_ALARM" />
                <action android:name="com.managesoundmode.app.action.GEOFENCE_TRANSITION" />
                <action android:name="com.managesoundmode.app.action.PASSIVE_LOCATION_UPDATE" />
                <action android:name="com.managesoundmode.app.action.GEOFENCE_DWELL_CHECK" />
                <action android:name="com.managesoundmode.app.action.NOTIFICATION_START_TIMER" />
                <action android:name="com.managesoundmode.app.action.NOTIFICATION_EXTEND_TIMER" />
                <action android:name="com.managesoundmode.app.action.NOTIFICATION_RESTORE_NOW" />
                <action android:name="com.managesoundmode.app.action.NOTIFICATION_REAPPLY_RULE" />
                <action android:name="com.managesoundmode.app.action.WIDGET_SET_MODE" />
                <action android:name="com.managesoundmode.app.action.WIDGET_CYCLE_MODE" />
                <action android:name="com.managesoundmode.app.action.ACTIVATE_PROFILE" />
            </intent-filter>
        </receiver>

        <!-- Widget de Tela Inicial com Jetpack Glance (2x1, 4x1 e 4x2) -->
        <receiver
            android:name=".widget.SoundModeWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sound_mode_widget_info" />
        </receiver>

        <!-- Quick Settings Tiles nativos no Header de Notificações do Android -->
        <!-- 0. Bloco Alternador Único (Ciclo: Som -> Vibrar -> Silêncio) -->
        <service
            android:name=".tile.SoundModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_sound_mode"
            android:label="@string/qs_tile_cycle_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Opção A: Trio de Modos Diretos (Som | Vibrar | Silêncio) -->
        <service
            android:name=".tile.NormalModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_volume_up"
            android:label="@string/qs_tile_normal_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.VibrateModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_vibration"
            android:label="@string/qs_tile_vibrate_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.SilentModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_silent"
            android:label="@string/qs_tile_silent_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Opção B: Slots de Perfis Favoritos (Slot 1 & Slot 2) -->
        <service
            android:name=".tile.ProfileSlot1TileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_style"
            android:label="@string/qs_tile_profile_1_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.ProfileSlot2TileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_style"
            android:label="@string/qs_tile_profile_2_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Opção C: Tile de Timer Rápido (30m / 1h / 2h) -->
        <service
            android:name=".tile.QuickTimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_timer"
            android:label="@string/qs_tile_timer_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Opção D: Tile Zero Mídia (Mudo Instantâneo de Mídia) -->
        <service
            android:name=".tile.MediaMuteTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_media_mute"
            android:label="@string/qs_tile_media_mute_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
