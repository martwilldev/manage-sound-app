# ==============================================================================
# .env.example — Variáveis de Ambiente da Esteira CI/CD (Modos de Som)
# ==============================================================================
# Copie para .env (nunca comitado no Git):
#   cp .env.example .env

# 1. Assinatura do App Bundle Release (relativo à pasta app/)
RELEASE_STORE_FILE=keystore/manage-sound-release.jks
RELEASE_STORE_PASSWORD=change_me_in_production
RELEASE_KEY_ALIAS=managesoundmode
RELEASE_KEY_PASSWORD=change_me_in_production

# 2. Publicação Automatizada na Google Play Store (API v3)
# Faixas: alpha (Teste Fechado), internal (Teste Interno), beta (Teste Aberto), production (Produção)
PLAY_STORE_TRACK=alpha
PLAY_STORE_RELEASE_STATUS=completed

# Caminho para o arquivo JSON da Conta de Serviço do Google Cloud/Play Console
PLAY_STORE_SERVICE_ACCOUNT_FILE=app/keystore/play-service-account.json
